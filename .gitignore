# ===============================================================
#  .gitignore  -- 请保持本文件为【合法 UTF-8】【无 BOM】
#
#  [历史事故] 本文件曾被以 GBK 编码写入，产生非法 UTF-8 字节（0xC1），
#  导致 git 完全无法解析整个 .gitignore -- 所有规则失效，
#  结果 data/raw/ 下约 810 MB 的 K 线被提交进仓库（自 083250d 起）。
#  改完本文件请自检：
#      python -c "open('.gitignore',encoding='utf-8').read()"
#  报 UnicodeDecodeError 即说明编码又坏了。
# ===============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ---------- 运行期状态（锁 / 心跳 / 临时文件）----------
data/spread/.sampler.lock
data/spread/.sampler_universe.lock
data/spread/.orderbook_sampler.lock
data/spread/.supervisor.lock
data/spread/_heartbeat.json
data/spread/_heartbeat_universe.json
data/spread/*.tmp
data/.kline_accumulator.lock
data/manifest.json.tmp
data/logs/

# ---------- 大体积回补数据（不要入库）----------
# K 线可用 python kline_accumulator.py --gran "1m,5m,1h,1D" 随时重抓；
# 单 1m 就 400 MB+，入库会拖垮仓库并让队友克隆变慢。
# 要给别人数据样本时，放受控体积的代表文件到 data/samples/（允许入库）。
data/raw/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ---------- 环境与密钥（禁止提交）----------
.env
*.key
secrets.json

# ---------- 临时提交信息文件（反复手滑，用通配防住）----------
MSG*.txt
COMMIT_MSG*.txt
COMMIT_MSG*.tmp*
*.tmp.txt
MSG_DECOMP.txt

# ---------- 采样原始 CSV（体积大且持续增长）----------
# 当天文件越写越大（orderbook 实测约 2.3 MB/小时，已触发 GitHub 50 MB 警告，
# 约 21 小时后会撞 100 MB 硬限）。压缩到约 15% 后放 data/spread/gz/ 入库。
# 原始 csv 留在本地供采样器继续写；队友要原始数据可解压 gz：
#     python tools/archive_samples.py     # 重新压缩（幂等）
data/spread/*.csv
!data/spread/gz/
MSG_ARCH.txt
