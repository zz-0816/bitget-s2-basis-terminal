{
  "endpoint": "https://datahub.noxiaohao.com/mcp",
  "tools": [
    {
      "name": "crypto_market",
      "description": "CoinGecko crypto market data: search coins, get price/OHLCV, market cap rankings, trending coins, global market stats.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "search",
              "price",
              "ohlcv",
              "markets",
              "trending",
              "global"
            ],
            "description": "Action to perform"
          },
          "query": {
            "type": "string",
            "description": "Search query (action=search)"
          },
          "coin_ids": {
            "type": "string",
            "description": "Comma-separated CoinGecko IDs for price, e.g. 'bitcoin,ethereum'"
          },
          "coin_id": {
            "type": "string",
            "description": "Single CoinGecko ID for ohlcv, e.g. 'bitcoin'"
          },
          "vs_currency": {
            "type": "string",
            "description": "Quote currency (default: usd)"
          },
          "days": {
            "type": "integer",
            "description": "Days of OHLCV history (1/7/30/90/180/365, default 180)",
            "minimum": 1,
            "maximum": 365
          },
          "per_page": {
            "type": "integer",
            "description": "Results per page for markets (default 20, max 250)",
            "minimum": 1,
            "maximum": 250
          },
          "page": {
            "type": "integer",
            "description": "Page number (default 1)",
            "minimum": 1
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "defi_analytics",
