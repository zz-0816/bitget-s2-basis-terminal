    {
      "name": "technical_analysis",
      "description": "Technical analysis on crypto pairs: RSI, MACD, Bollinger Bands, MA/EMA, ATR, support/resistance levels, full composite analysis, and batch analysis for multiple symbols.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "rsi",
              "macd",
              "bollinger",
              "ma",
              "ema",
              "atr",
              "support_resistance",
              "full_analysis",
              "batch_analysis"
            ]
          },
          "symbol": {
            "type": "string",
            "description": "Trading pair, e.g. BTC/USDT (required for single-coin actions)"
          },
          "symbols": {
            "type": "string",
            "description": "Comma-separated pairs for batch_analysis"
          },
          "timeframe": {
            "type": "string",
            "description": "Candle timeframe: 1h, 4h, 1d, etc. (default: 4h)"
          },
          "period": {
            "type": "integer",
            "description": "Indicator lookback period (2-500, default: 14)",
            "minimum": 2,
            "maximum": 500
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "backtest",
      "description": "Run historical backtests on trading strategies using VectorBT. Fetches OHLCV from exchange (ccxt), computes indicators (RSI/MACD/BB/EMA/ATR), evaluates entry/exit signals, simulates portfolio, returns structured metrics (return%, Sharpe, max drawdown, win rate, profit factor). Optionally generates equity curve chart. Supports pre-fetched OHLCV via ohlcv_json for coingecko/yfinance data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "run",
              "chart"
            ],
            "description": "run=execute backtest, chart=regenerate chart from previous metrics"
          },
          "strategy_config": {
            "type": "string",
            "description": "JSON string with strategy config. Keys: name, symbols (list), timeframe, indicators (list of {name, params, key}), entry_conditions (list of {indicator, field, operator, value}), exit_conditions, direction (long/short/both), stop_loss_pct, take_profit_pct, trade_size_pct, fees."
          },
          "period": {
            "type": "string",
            "description": "Lookback period, e.g. '6m', '1y', '30d'. Default: 6m"
          },
          "exchange": {
            "type": "string",
            "enum": [
              "binance",
              "bitget",
              "okx",
              "bybit",
              "coinbase",
              "kraken",
              "kucoin"
            ],
            "description": "Exchange for OHLCV data. Default: binance"
          },
          "starting_balance": {
            "type": "number",
            "description": "Initial cash. Default: 100000"
          },
          "ohlcv_json": {
            "type": "string",
            "description": "Pre-fetched OHLCV as JSON string (from coingecko/yfinance tools). Format: {\"SYMBOL\": [{\"timestamp\":ms,\"open\":...,\"close\":...}, ...]}"
          },
          "metrics_json": {
            "type": "string",
            "description": "For action=chart: JSON metrics from a previous run."
          },
          "generate_chart": {
            "type": "boolean",
            "description": "Generate equity curve chart (requires playwright). Default: false"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "macro_indicators",
      "description": "Macro economic calendar and indicators: CPI, Non-Farm Payrolls, FOMC decisions, GDP growth, unemployment, retail sales, PPI, ISM PMI, and more. Data from FRED (Federal Reserve). Set FRED_API_KEY for higher rate limits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "latest_release",
              "history",
              "fomc_news",
              "multi_indicator",
              "series_list"
            ],
            "description": "latest_release=most recent value for an indicator, history=historical series data, fomc_news=recent Fed monetary policy news from RSS, multi_indicator=key macro snapshot (CPI+NFP+GDP+unemployment), series_list=list available indicator keys"
          },
          "indicator": {
            "type": "string",
            "description": "Indicator key, e.g. 'cpi', 'nonfarm_payrolls', 'gdp_growth', 'unemployment', 'core_pce', 'ppi', 'consumer_sentiment', 'retail_sales', 'industrial_production'. See action=series_list for full list."
          },
          "limit": {
            "type": "integer",
            "description": "Number of historical observations (default 12, max 120)",
            "minimum": 1,
            "maximum": 120
          },
          "indicators": {
            "type": "string",
            "description": "Comma-separated indicator keys for multi_indicator action"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "rates_yields",
      "description": "US interest rates and bond yields: Treasury yield curve (3M/1Y/2Y/5Y/10Y/30Y), Federal funds rate and target bands, SOFR, mortgage rates, credit spreads, 10Y-2Y spread (recession indicator), breakeven inflation. Data from FRED (Federal Reserve). Set FRED_API_KEY for higher rate limits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "yield_curve",
              "fed_funds",
              "rate",
              "history",
              "rates_snapshot",
              "series_list"
            ],
            "description": "yield_curve=full Treasury yield curve snapshot, fed_funds=current Fed funds rate + target bands, rate=specific rate by key, history=historical series, rates_snapshot=key rates dashboard (yield curve + Fed + spreads), series_list=list available rate keys"
          },
          "rate_key": {
            "type": "string",
            "description": "Rate key for rate/history actions: t2y, t10y, t30y, t3m, fed_funds, fed_funds_target_upper, spread_10y2y, breakeven_10y, sofr, prime_rate, mortgage_30y, hy_spread, ig_spread, tips_10y. See action=series_list."
          },
          "limit": {
            "type": "integer",
            "description": "Number of observations for history (default 30, max 252)",
            "minimum": 1,
            "maximum": 252
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "cross_asset",
      "description": "Rolling cross-asset correlation: BTC vs Gold, DXY, Nasdaq, S&P500, 10Y Treasury yield, EUR/USD, oil, VIX, and any other Yahoo Finance symbol. Returns Pearson correlation (full period + rolling window) with trend and interpretation. No API key required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "correlation",
              "assets_list",
              "heatmap"
            ],
            "description": "correlation=compute correlation between base and targets, assets_list=list available asset keys and Yahoo symbols, heatmap=full correlation matrix for a set of assets"
          },
          "base": {
            "type": "string",
            "description": "Base asset key or Yahoo Finance symbol (default: btc → BTC-USD)"
          },
          "targets": {
            "type": "string",
            "description": "Comma-separated target asset keys or Yahoo symbols. Default: gold,dxy,ndx,spx,t10y,vix. Use assets_list action to see available keys."
          },
          "period": {
            "type": "string",
            "enum": [
              "30d",
              "90d",
              "180d",
              "1y",
              "2y",
              "5y"
            ],
            "description": "Lookback period (default: 1y)"
          },
          "window": {
            "type": "integer",
            "description": "Rolling window in trading days (default: 30, range: 5-252)",
            "minimum": 5,
            "maximum": 252
          },
          "assets": {
            "type": "string",
            "description": "Comma-separated assets for heatmap (default: btc,gold,dxy,ndx,spx,t10y,oil)"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  ]
}